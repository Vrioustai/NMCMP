{
  "name": "movie-platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @movie/contracts --filter @movie/web --filter @movie/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @movie/api test:e2e",
    "format": "prettier --write apps packages infra",
    "format:check": "prettier --check apps packages infra",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @movie/api prisma migrate dev",
    "db:studio": "pnpm --filter @movie/api prisma studio"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-next": "^15.5",
    "prettier": "^3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8"
  }
}
