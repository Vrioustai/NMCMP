# Chung
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000   # trang web; dùng để kiểm Origin
API_PORT=4000
TZ_APP=Asia/Ho_Chi_Minh
MEDIA_DIR=./uploads                # ảnh phim và phụ đề

# CSDL và bộ nhớ đệm
DATABASE_URL=postgresql://movie:movie@localhost:5432/movie_platform?schema=public
DATABASE_URL_TEST=postgresql://movie:movie@localhost:5432/movie_platform_test?schema=public
REDIS_URL=redis://localhost:6379

# Phiên đăng nhập
JWT_SECRET=            # chuỗi ngẫu nhiên ≥ 32 ký tự
SESSION_TTL_DAYS=7
COOKIE_SECURE=         # bỏ trống = true; máy cá nhân chạy http thì đặt false

# Video
VIDEO_PROVIDER=fake    # fake | cloudflare
PLAYBACK_TOKEN_TTL_SEC=7200
# Luồng HLS mẫu công khai (Mux) khi VIDEO_PROVIDER=fake. Test tự động không tải luồng này.
FAKE_HLS_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_CUSTOMER_CODE=
CF_STREAM_KEY_ID=
CF_STREAM_KEY_JWK=     # base64 của khóa ký, chỉ ở máy chủ API

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FilmGenZ <no-reply@filmgenz.local>"

# Seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
