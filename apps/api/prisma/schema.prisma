generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum UserStatus {
  ACTIVE
  LOCKED

  @@map("user_status")
}

enum MovieType {
  MOVIE
  SERIES

  @@map("movie_type")
}

enum MovieStatus {
  DRAFT
  PUBLISHED

  @@map("movie_status")
}

enum AgeRating {
  P
  K
  T13
  T16
  T18

  @@map("age_rating")
}

enum CreditRole {
  DIRECTOR
  ACTOR

  @@map("credit_role")
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED

  @@map("report_status")
}

enum ModerationAction {
  HIDE
  DELETE
  WARN

  @@map("moderation_action")
}

model User {
  id           Int        @id @default(autoincrement()) @map("id_user")
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name")
  avatarUrl    String?    @map("avatar_url")
  birthYear    Int        @map("birth_year")
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  passwordResetTokens PasswordResetToken[]
  watchHistories      WatchHistory[]
  danmakus            Danmaku[]
  comments            Comment[]
  ratings             Rating[]
  favorites           Favorite[]
  reportsFiled        Report[]           @relation("ReportReporter")
  reportsResolved     Report[]           @relation("ReportResolver")
  bannedWordsCreated  BannedWord[]

  @@map("users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement()) @map("id_password_reset_token")
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Movie {
  id            Int         @id @default(autoincrement()) @map("id_movie")
  slug          String      @unique
  title         String
  originalTitle String?     @map("original_title")
  description   String
  type          MovieType
  releaseYear   Int         @map("release_year")
  ageRating     AgeRating   @map("age_rating")
  status        MovieStatus @default(DRAFT)
  posterUrl     String?     @map("poster_url")
  backdropUrl   String?     @map("backdrop_url")
  trailerUrl    String?     @map("trailer_url")
  sourceUrl     String?     @map("source_url")
  license       String?
  publishedAt   DateTime?   @map("published_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  genres    MovieGenre[]
  countries MovieCountry[]
  credits   MovieCredit[]
  episodes  Episode[]
  comments  Comment[]
  ratings   Rating[]
  favorites Favorite[]

  @@index([status, publishedAt])
  @@map("movies")
}

model Genre {
  id     Int          @id @default(autoincrement()) @map("id_genre")
  name   String       @unique
  movies MovieGenre[]

  @@map("genres")
}

model MovieGenre {
  movieId Int   @map("movie_id")
  genreId Int   @map("genre_id")
  movie   Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([movieId, genreId])
  @@index([genreId])
  @@map("movie_genres")
}

model Country {
  id     Int            @id @default(autoincrement()) @map("id_country")
  name   String         @unique
  movies MovieCountry[]

  @@map("countries")
}

model MovieCountry {
  movieId   Int     @map("movie_id")
  countryId Int     @map("country_id")
  movie     Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@id([movieId, countryId])
  @@index([countryId])
  @@map("movie_countries")
}

model Person {
  id      Int           @id @default(autoincrement()) @map("id_person")
  name    String
  credits MovieCredit[]

  @@map("people")
}

model MovieCredit {
  movieId  Int        @map("movie_id")
  personId Int        @map("person_id")
  role     CreditRole
  movie    Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person   Person     @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([movieId, personId, role])
  @@map("movie_credits")
}

model Episode {
  id           Int     @id @default(autoincrement()) @map("id_episode")
  movieId      Int     @map("movie_id")
  seasonNumber Int     @default(1) @map("season_number")
  number       Int
  title        String?
  streamUid    String? @map("stream_uid")
  durationSec  Int?    @map("duration_sec")
  movie        Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)

  subtitles      Subtitle[]
  watchHistories WatchHistory[]
  danmakus       Danmaku[]

  @@unique([movieId, seasonNumber, number])
  @@map("episodes")
}

model Subtitle {
  id        Int     @id @default(autoincrement()) @map("id_subtitle")
  episodeId Int     @map("episode_id")
  language  String
  url       String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, language])
  @@map("subtitles")
}

model WatchHistory {
  id          Int      @id @default(autoincrement()) @map("id_watch_history")
  userId      Int      @map("user_id")
  episodeId   Int      @map("episode_id")
  progressSec Int      @default(0) @map("progress_sec")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([createdAt])
  @@map("watch_histories")
}

model Danmaku {
  id        Int       @id @default(autoincrement()) @map("id_danmaku")
  episodeId Int       @map("episode_id")
  userId    Int       @map("user_id")
  content   String    @db.VarChar(100)
  timeMs    Int       @map("time_ms")
  isHidden  Boolean   @default(false) @map("is_hidden")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  episode   Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports   Report[]

  @@index([episodeId, timeMs])
  @@map("danmakus")
}

model Comment {
  id        Int      @id @default(autoincrement()) @map("id_comment")
  movieId   Int      @map("movie_id")
  userId    Int      @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([movieId, createdAt])
  @@map("comments")
}

model Rating {
  userId    Int      @map("user_id")
  movieId   Int      @map("movie_id")
  score     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([movieId])
  @@map("ratings")
}

model Favorite {
  userId    Int      @map("user_id")
  movieId   Int      @map("movie_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@map("favorites")
}

model Report {
  id             Int               @id @default(autoincrement()) @map("id_report")
  reporterUserId Int               @map("reporter_user_id")
  danmakuId      Int               @map("danmaku_id")
  reason         String
  status         ReportStatus      @default(PENDING)
  action         ModerationAction?
  resolverUserId Int?              @map("resolver_user_id")
  resolvedAt     DateTime?         @map("resolved_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  reporter       User              @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  resolver       User?             @relation("ReportResolver", fields: [resolverUserId], references: [id], onDelete: SetNull)
  danmaku        Danmaku           @relation(fields: [danmakuId], references: [id], onDelete: Cascade)

  @@unique([reporterUserId, danmakuId])
  @@index([status, createdAt])
  @@map("reports")
}

model BannedWord {
  id            Int      @id @default(autoincrement()) @map("id_banned_word")
  word          String   @unique
  creatorUserId Int      @map("creator_user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  creator       User     @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)

  @@map("banned_words")
}
