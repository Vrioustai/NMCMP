{
  "name": "@movie/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand --passWithNoTests",
    "prisma": "prisma",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/fixtures/dev.ts",
    "import:movies": "tsx scripts/import-movies.ts"
  },
  "dependencies": {
    "@movie/contracts": "workspace:*",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/jwt": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/platform-socket.io": "^11",
    "@nestjs/websockets": "^11",
    "@prisma/client": "^6",
    "argon2": "0.45",
    "class-transformer": "^0.5",
    "class-validator": "^0.15",
    "cookie-parser": "1.4",
    "helmet": "8",
    "ioredis": "6",
    "nodemailer": "^10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8",
    "zod": "4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^12",
    "@nestjs/testing": "^11",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6",
    "jest": "^30",
    "prisma": "^6",
    "socket.io-client": "^4.8",
    "supertest": "^7",
    "ts-jest": "^29.4",
    "tsx": "^4",
    "typescript": "~5.9.0"
  }
}
