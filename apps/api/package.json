{
  "name": "@movie/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand --passWithNoTests",
    "prisma": "prisma",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:seed:dev": "tsx prisma/fixtures/dev.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@movie/contracts": "workspace:*",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@prisma/client": "^6",
    "class-transformer": "^0.5",
    "class-validator": "^0.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@types/jest": "^30",
    "@types/node": "^22",
    "@types/supertest": "^6",
    "jest": "^30",
    "prisma": "^6",
    "supertest": "^7",
    "ts-jest": "^29.4",
    "tsx": "^4",
    "typescript": "~5.9.0"
  }
}
